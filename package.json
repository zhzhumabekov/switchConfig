{
  "name": "switchconfig",
  "version": "1.0.0",
  "description": "Просмотр конфигураций коммутаторов Huawei и Cisco",
  "main": "electron/main.js",
  "scripts": {
    "fetch": "node fetch-config.js",
    "update": "node update-config.js",
    "watch": "node update-config.js --watch",
    "start": "node server.js",
    "app": "electron .",
    "dist": "electron-builder --win",
    "icon": "node build/make-icon.js"
  },
  "keywords": [],
  "author": "Zhumabekov Zhomart",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3"
  },
  "productName": "switchConfig",
  "build": {
    "appId": "local.switchconfig",
    "productName": "switchConfig",
    "directories": {
      "output": "dist"
    },
    "files": [
      "*.js",
      "!config.js",
      "index.html",
      "settings.html",
      "style.css",
      "directory.ps1",
      "electron/**",
      "package.json",
      "build/icon.png"
    ],
    "asarUnpack": [
      "directory.ps1"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Конфигурации коммутаторов"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    }
  }
}
